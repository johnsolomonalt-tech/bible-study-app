# -----------------------------------------------------------------------------
# Theologica Production Environment Configuration Template
# Copy this file to .env.local (development) or configure in your production host
# (Vercel, Render, Railway, AWS, etc.)
# -----------------------------------------------------------------------------

# --- Base Application Configuration ---
NEXT_PUBLIC_APP_URL="https://theologica.app"

# --- Database Configuration (Required) ---
# PostgreSQL connection string for Prisma ORM.
# In serverless environments (Vercel, Supabase, Neon), use a pooled connection string:
DATABASE_URL="postgresql://username:password@hostname:6543/dbname?schema=public&pgbouncer=true&connection_limit=1"

# Direct unpooled connection string (used by Prisma CLI for running migrations)
DIRECT_URL="postgresql://username:password@hostname:5432/dbname?schema=public"


# --- Authentication: Clerk (Required) ---
# Obtain from Clerk Dashboard: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
# Optional custom redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# --- Artificial Intelligence: Google Gemini (Required for Theologica AI) ---
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# --- Sacred Artwork Generation: Pixazo (Optional / Flux image generation) ---
# Obtain from Pixazo AI developer gateway
PIXAZO_API_KEY=""

# --- Scripture API: API.Bible (Optional / for copyrighted translations like ESV, NIV) ---
# Obtain from https://scripture.api.bible/
BIBLE_API_KEY=""

# --- Developer & Admin Portal Security ---
# Secret randomized URL slug for accessing the Developer Console (default: console-7d8f9e6b4a3c21d0)
DEV_PORTAL_SLUG="console-7d8f9e6b4a3c21d0"

# Comma-separated list of authorized Clerk User IDs allowed to access Developer Console
ADMIN_USER_IDS="user_..."

# Comma-separated list of authorized Admin Emails allowed to access Developer Console
ADMIN_EMAILS="admin@yourdomain.com"

# Password for unlocking the Developer Dashboard (mandatory in production)
DEV_ADMIN_PASSWORD=""

# Secret key used for signing Developer session cookies (minimum 32 characters)
DEV_SESSION_SECRET=""
