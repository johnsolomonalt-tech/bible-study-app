// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    String   @default("legacy")
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chat {
  id        Int       @id @default(autoincrement())
  userId    String    @default("legacy")
  title     String
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String   // 'user' or 'model'
  content   String
  createdAt DateTime @default(now())
}

model Tracker {
  id               Int      @id @default(autoincrement())
  userId           String   @default("legacy")
  chapterId        String   // Format: "{BookName}-{ChapterNumber}", e.g., "Genesis-1"
  completedAt      DateTime @default(now())
  
  @@unique([userId, chapterId])
}

model Highlight {
  id        Int      @id @default(autoincrement())
  userId    String   @default("legacy")
  book      String
  chapter   Int
  verse     Int
  text      String
  color     String
  createdAt DateTime @default(now())
}

model Canvas {
  id        String   @id @default(cuid())
  boardId   String
  userId    String   @default("legacy")
  title     String   @default("Untitled Canvas")
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  viewport  Json?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, boardId])
  @@index([userId])
  @@index([boardId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  anonymousId String   @default("anon")
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([eventType, timestamp])
  @@index([timestamp])
  @@index([anonymousId, timestamp])
}

model DevAdminConfig {
  id             String   @id @default("default")
  passwordHash   String
  salt           String
  adminUserId    String?
  adminEmail     String?
  allowedEmails  String[] @default([])
  allowedUserIds String[] @default([])
  updatedAt      DateTime @updatedAt
}

